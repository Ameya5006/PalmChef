# Server only. Never prefix the key with VITE_.
GEMINI_API_KEY=replace-with-a-server-side-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Render Web Service sets PORT. AI_PORT is only a local fallback.
AI_PORT=3001
# Exact frontend origin, for example https://palmchef.onrender.com (no trailing slash).
AI_ALLOWED_ORIGIN=http://localhost:5173
# On the Render Static Site, set to the AI Web Service HTTPS origin only:
# https://palmchef-ai.onrender.com (no /api/ai path). Leave blank for Vite proxy.
VITE_AI_API_BASE=
